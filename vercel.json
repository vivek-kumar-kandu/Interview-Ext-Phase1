{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://interview-ext-backend.onrender.com/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/sidepanel.html"
        }
    ],
    "buildCommand": "cd frontend && npm install && npm run build",
    "outputDirectory": "frontend/dist",
    "framework": null
}